# --- Discord (required) ---
# Bot token from https://discord.com/developers/applications -> your app -> Bot.
DISCORD_TOKEN=
# Your server's ID. Commands register there instantly; leave empty to register globally.
DISCORD_GUILD_ID=

# --- Agent ---
AGENT=devin
# Devin service-user key (Settings -> Devin API -> Service users) and organization ID.
DEVIN_API_KEY=
DEVIN_ORG_ID=
# Optional: cap each task's ACUs, default repos, extra tags.
DEVIN_MAX_ACU=
DEVIN_REPOS=
DEVIN_TAGS=
# Optional: run tasks as Devin users, as discordUserId:devinUserId pairs separated by commas.
DEVIN_USER_MAP=

# --- Behaviour (all optional) ---
# Channel where task threads open (text or forum). Defaults to the channel the request came from.
TASK_CHANNEL_ID=
# Roles allowed to use the bot besides Administrators, comma separated.
ALLOWED_ROLE_IDS=
# Reacting with this emoji starts a task. A custom emoji's ID also works. Empty disables it.
TRIGGER_EMOJI=🤖
# Thread messages starting with this are not forwarded to the agent.
IGNORE_PREFIX=//
# How often to check tasks for new messages, PRs and status changes.
POLL_INTERVAL_SECONDS=30
# Appended to every task prompt.
TASK_INSTRUCTIONS=
