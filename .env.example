# Host settings only. Each Discord server is set up in the web UI at PUBLIC_URL,
# and its Devin key, roles and channels are stored (encrypted) in the database.

# --- Discord app (https://discord.com/developers/applications) ---
# Bot -> Reset Token.
DISCORD_TOKEN=
# OAuth2 -> Client ID and Client Secret. Used for "Sign in with Discord".
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Web UI ---
# Encrypts every server's Devin key and signs cookies. At least 32 characters;
# generate one with: openssl rand -base64 48
# Changing or losing it makes saved keys unreadable (servers must re-enter them).
MASTER_KEY=
# Where the setup UI is reached, https only (http only for localhost).
# Add <PUBLIC_URL>/auth/callback as a redirect in the Discord app's OAuth2 settings.
PUBLIC_URL=https://devin.example.com
PORT=3000

# --- Cloudflare Tunnel (docker compose) ---
# quick-tunnel: random trycloudflare.com URL, changes when the tunnel restarts.
# named-tunnel: fixed hostname; set TUNNEL_TOKEN from Cloudflare Zero Trust -> Networks -> Tunnels.
COMPOSE_PROFILES=quick-tunnel
TUNNEL_TOKEN=

# --- Optional ---
# Where the SQLite database lives. The Docker image uses /data.
DATA_DIR=./data
# How often to check tasks for new messages, PRs and status changes.
POLL_INTERVAL_SECONDS=30
